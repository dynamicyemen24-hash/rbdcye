# ============================================================
# Production Environment - Cloudflare Pages
# ============================================================
# Vite inlines VITE_* prefixed variables at build time.
# Real secret values (Supabase, Stripe, Database) should be
# set in Cloudflare Pages → Settings → Environment Variables.
# This file is for local build verification only.

# Application
VITE_APP_NAME=مؤسسة رحماء بينهم للإغاثة والتنمية
VITE_APP_URL=https://rbdcye.org
VITE_ADMIN_URL=https://admin.rbdcye.org
VITE_NODE_ENV=production
VITE_ENV=production

# API
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT=30000

# Sanity CMS - Production
VITE_SANITY_PROJECT_ID=xd0ohyiz
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2026-02-01

# Supabase Auth (Production) - set real values in Cloudflare Pages env
VITE_SUPABASE_URL=https://db.tnzlusiymgdvsqfufmme.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InRuemx1c2l5bWdkdnNxZnVmbW1lIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzgxNDM5MTgsImV4cCI6MjA5MzcxOTkxOH0.cFK0ewweyiP63-h4v1cJgZaNhBkcK37bU8mptfggNNw
VITE_SUPABASE_SCHEMA=public

# Stripe Payments
VITE_STRIPE_PUBLIC_KEY=YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY

# PostgreSQL (Neon)
DATABASE_URL=postgresql://postgres:ZQ0rKpsxDXA8JbHa@db.tnzlusiymgdvsqfufmme.supabase.co:5432/postgres
PG_SCHEMA=public

# Feature Flags
VITE_ENABLE_DEMO_AUTH=false
VITE_FORCE_LIVE_DB=true
VITE_USE_SANITY=true
VITE_ENABLE_PWA=true
VITE_ENABLE_PAYMENTS=true

# CORS
CORS_ORIGIN=https://rbdcye.org,https://www.rbdcye.org,https://admin.rbdcye.org,http://localhost:5173