{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 3,
      "settings": {
        "preset": "mobile",
        "chromeFlags": "--no-sandbox",
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 390,
          "height": 844
        },
        "throttling": {
          "rttMs": 150,
          "throughputKbps": 1638.4,
          "cpuSlowdownMultiplier": 4
        }
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "metrics:first-contentful-paint": ["error", { "minScore": 0.8 }],
        "metrics:largest-contentful-paint": ["error", { "minScore": 0.8 }],
        "metrics:cumulative-layout-shift": ["error", { "minScore": 0.95 }],
        "metrics:first-input-delay": ["error", { "minScore": 0.9 }],
        "metrics:interaction-to-next-paint": ["error", { "minScore": 0.9 }],
        "metrics:time-to-first-byte": ["error", { "minScore": 0.8 }],
        "metrics:total-blocking-time": ["error", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
