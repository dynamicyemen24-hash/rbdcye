# Neon Database Configuration
# ============================================================
# Use this file to configure the Neon database connection directly

# Production Database - Rohamaa_DB_ERP
# WARNING: Never commit real credentials to git!
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD_HERE@your-endpoint/Rohamaa_DB_ERP?sslmode=require

# Database Schema
PG_SCHEMA=public

# Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_TIMEOUT=30

# ============================================================
# Setup Instructions:
# 1. Copy this file to .env.local
# 2. Replace YOUR_PASSWORD_HERE with your actual password
# 3. Add to Vercel/Cloudflare Environment Variables
# 4. Run migration: psql "$DATABASE_URL" -f scripts/migrations/01_create_tables.sql
# ============================================================
